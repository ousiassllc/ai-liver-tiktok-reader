# Server Configuration
PORT=8472

# TikTok API (Optional - for rate limit avoidance)
# eulerapi.io のAPIキー。設定するとTikTokのレート制限を回避できる
TIKTOK_EULER_API_KEY=

# ===========================================
# マルチインスタンス対応設定
# ===========================================

# Google Cloud Project ID（Firestore / Pub/Sub用）
# 開発環境: ai-liver-local（エミュレータ用）
# 本番環境: 実際のGCPプロジェクトID
GCP_PROJECT_ID=ai-liver-local

# Firestore 分散ロック
# FIRESTORE_EMULATOR_HOST は開発環境だけで設定する。
# ローカル: localhost:8787
# Docker Compose: firestore-emulator:8080
FIRESTORE_EMULATOR_HOST=localhost:8787
FIRESTORE_LOCK_COLLECTION=ai-liver-local-tiktok-locks

# Pub/Sub エミュレータ設定（開発環境のみ）
# 設定するとエミュレータに接続する。本番環境では設定しない。
# ローカル: localhost:8085
# Docker Compose: pubsub-emulator:8085
PUBSUB_EMULATOR_HOST=localhost:8085

# Pub/Sub設定
PUBSUB_TOPIC_NAME=tiktok-events
PUBSUB_SUBSCRIPTION_NAME=tiktok-events-sub

# Pub/Sub サブスクリプションの動作設定（オプション）
# true にするとprocess shutdown時にinstance固有サブスクリプションを削除する。
# falseでも未使用subscriptionは下記expiration TTL後に自動削除される。
PUBSUB_DELETE_SUBSCRIPTION_ON_CLOSE=false

# Pub/Sub サブスクリプションの有効期限（秒、オプション）
# 未指定の場合は24時間。Cloud Runの終了処理が走らなくても自動削除される。
PUBSUB_SUBSCRIPTION_EXPIRATION_TTL_SECONDS=86400

# インスタンスID（オプション）
# 未設定の場合は自動生成される
INSTANCE_ID=

# ===========================================
# Backend 連携設定
# ===========================================

# Backend REST の呼び出し先。`/api/v1` まで含める（例: http://localhost:8471/api/v1）。
# render token の検証（GET /render/sessions/:id/bootstrap）と、
# `/internal/tiktok-reader/*` へのイベント転送（gift / comment / viewer-count）に使用する。
# Issue #2782: 既定値は無く、未設定なら backend 連携は無効（render token 認証は常に拒否、
# イベント転送は行わない）。shared secret 認証だけで単独利用する場合は未設定のままにする。
# BACKEND_API_URL=http://localhost:8471/api/v1

# Backend イングレストークン（Issue #726）
# `/api/v1/internal/tiktok-reader/*` を呼び出す際の X-Ingress-Token 値。
# 未設定の場合は 401 で拒否される。
BACKEND_INGRESS_TOKEN=

# Render トークン検証のタイムアウト（ミリ秒、オプション）
# WebSocket 接続時に backend の RenderTokenVerifier を呼び出す際のタイムアウト。
BACKEND_RENDER_VERIFY_TIMEOUT_MS=

# ===========================================
# 接続レート制限（Issue #589）
# ===========================================

TIKTOK_READER_RATE_LIMIT_ENABLED=true
TIKTOK_READER_RATE_LIMIT_MAX=60
TIKTOK_READER_RATE_LIMIT_WINDOW_MS=60000
TIKTOK_READER_TRUST_PROXY=true
# run.app直結は0。前段に信頼済みproxyを置く場合は、そのhop数を指定する。
TIKTOK_READER_TRUST_PROXY_HOPS=0

# ===========================================
# 同時接続数の上限（Issue #590）
# ===========================================

# 本インスタンスが保持する WebSocket クライアント総数の上限。0 または未設定は制限なし。
TIKTOK_READER_MAX_TOTAL_CLIENTS=0
# 1 TikTok ユーザー（配信者）あたりの WebSocket クライアント数の上限。0 または未設定は制限なし。
TIKTOK_READER_MAX_CLIENTS_PER_USER=0

# ===========================================
# 対応ソース案内（AGPL / Issue #2782）
# ===========================================

# GET /source が返す、稼働版に対応するソースの URL。改変版をネットワークサービスとして
# 動かす場合は、改変後のソースを取得できる URL を必ず設定する。
TIKTOK_READER_SOURCE_URL=
# 稼働版の識別子。Docker image では build arg SOURCE_COMMIT から設定される。
SOURCE_COMMIT=

# ===========================================
# WebSocket 認証設定（Issue #825 / #1437）
# ===========================================

# Shared secret 認証用のトークン
# クライアントは `X-Reader-Secret: <secret>` ヘッダ（推奨）または
# `?secret=<secret>` クエリで接続する。
# 未設定の場合、shared secret認証は無効になり、render token経路のみ許可する。
TIKTOK_READER_SHARED_SECRET=
